# ───────────────────────────────────────────────────────────
# ตัวอย่างการตั้งค่า — คัดลอกไฟล์นี้เป็น .env.local สำหรับรันในเครื่อง
# บน Vercel ให้ใส่ค่าเหล่านี้ที่ Settings → Environment Variables
# ───────────────────────────────────────────────────────────

# connection string ของฐานข้อมูล PostgreSQL
# ตัวอย่าง Neon: postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ข้อความสุ่มยาวอย่างน้อย 32 ตัวอักษร ใช้เข้ารหัส session
# สร้างได้ด้วยคำสั่ง: openssl rand -base64 32
AUTH_SECRET=
